msgid "Current <em>stable</em> user documentation"
msgstr "Aktuell <em>stabil</em> användardokumentation"

#: docs.phtml:62 docs.phtml:207
msgid "Stable"
msgstr "Stabil"

#: docs.phtml:64 docs.phtml:209 docs.phtml:341 docs.phtml:514 docs.phtml:631
